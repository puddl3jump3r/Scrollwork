# Nexus Agent Configuration

# Ollama server URL (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Server bind address (default: 0.0.0.0 for LAN access)
HOST=0.0.0.0
PORT=8080

# Workspace directory (default: ./workspace)
WORKSPACE_DIR=./workspace

# Data directory for databases (default: ./data)
DATA_DIR=./data

# MCP config file path (default: ./mcp_config.json)
MCP_CONFIG=./mcp_config.json

# --- MCP API Keys (add as needed) ---

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=

# Firecrawl API Key
# Get at: https://firecrawl.dev
FIRECRAWL_API_KEY=

# ElevenLabs API Key
# Get at: https://elevenlabs.io
ELEVENLABS_API_KEY=

# E2B API Key
# Get at: https://e2b.dev
E2B_API_KEY=

# Ghidra installation directory (for GhidraMCP)
GHIDRA_INSTALL_DIR=
